---
import { navigationItems } from "../data/navigation";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const normalizePath = (path: string) => {
  if (path === "/") return "/";
  return path.replace(/\/+$/, "");
};

const currentPath = normalizePath(pathname);
const isActivePath = (href: string) => normalizePath(href) === currentPath;
---

<div class="d-drawer min-h-screen">
  <input id="site-drawer" type="checkbox" class="d-drawer-toggle" />
  <div class="d-drawer-content flex min-h-screen flex-col">
    <slot name="before-nav" />
    <div class="relative z-10 bg-base-200">
      <div class="sticky top-0 z-30 w-full shadow-md bg-base-200">
        <div class="d-navbar mx-auto w-full max-w-5xl px-6">
          <div class="d-navbar-start">
            <label
              for="site-drawer"
              aria-label="open sidebar"
              class="d-btn d-btn-square d-btn-ghost lg:hidden"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="inline-block h-6 w-6 stroke-current"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </label>
          </div>

          <div class="d-navbar-center hidden lg:flex">
            <div role="tablist" class="d-tabs d-tabs-border">
              {
                navigationItems.map((item) => (
                  <a
                    role="tab"
                    href={item.href}
                    aria-current={isActivePath(item.href) ? "page" : undefined}
                    class={`d-tab text-xl ${isActivePath(item.href) ? "d-tab-active" : ""}`}
                  >
                    {item.label}
                  </a>
                ))
              }
            </div>
          </div>

          <div class="d-navbar-end"></div>
        </div>
      </div>
      <slot />
    </div>
  </div>

  <div class="d-drawer-side">
    <label for="site-drawer" aria-label="close sidebar" class="d-drawer-overlay"
    ></label>

    <ul class="d-menu bg-base-200 min-h-full w-80 p-4">
      <li>
        <h1
          class="text-5xl font-(family-name:--font-oooh-baby) self-center mt-3"
        >
          Balibalosch
        </h1>
      </li>
      <div class="d-divider"></div>
      {
        navigationItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActivePath(item.href) ? "page" : undefined}
              class={
                isActivePath(item.href)
                  ? "d-menu-active text-xl my-1"
                  : "text-xl my-1"
              }
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
