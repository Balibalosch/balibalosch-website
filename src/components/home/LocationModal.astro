---
import { Image } from "astro:assets";
import sketchImage from "../../assets/images/skizze.png";
---

<dialog id="my_modal" class="d-modal">
  <div class="d-modal-box">
    <Image
      src={sketchImage}
      alt="Skizze zum Eingang in der Schmiede in Leipzig-Plagwitz"
      class="h-auto w-full"
    />
  </div>
  <form method="dialog" class="d-modal-backdrop">
    <button>close</button>
  </form>
</dialog>
