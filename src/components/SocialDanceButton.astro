---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  cropClass: string;
  href: string;
  alt?: string;
}

const { src, cropClass, href, alt = "Social dance button" } = Astro.props;
---

<a href={href} class="lg:d-hover-3d m-2">
  <figure
    class="d-mask d-mask-circle h-24 w-24 overflow-hidden sm:h-28 sm:w-28"
  >
    <Image src={src} class={cropClass} alt={alt} />
  </figure>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
</a>
