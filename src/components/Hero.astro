---
import { Image } from "astro:assets";
import heroImage from "../assets/images/balibalosch-hero.webp";
---

<div
  class="d-hero fixed top-0 z-0 min-h-[20vh] overflow-hidden sm:min-h-[30vh] lg:min-h-[40vh]"
>
  <Image
    src={heroImage}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <div class="d-hero-overlay"></div>
  <div class="d-hero-content text-base-100 text-center justify-center">
    <div class="max-w-xl">
      <h1
        class="mb-5 text-6xl sm:text-7xl lg:text-8xl font-(family-name:--font-oooh-baby)"
      >
        Balibalosch
      </h1>
      <p class="mb-5 text-lg sm:text-xl lg:text-2xl">Balfolk in Leipzig</p>
    </div>
  </div>
</div>
<div class="h-[20vh] sm:h-[30vh] lg:h-[40vh]" aria-hidden="true"></div>
