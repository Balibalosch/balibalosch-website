---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
---

<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <Font cssVariable="--font-oooh-baby" />
  <title>Balibalosch</title>
  <ClientRouter />
  <script>
    import type { TransitionBeforePreparationEvent } from "astro:transitions/client";

    declare global {
      interface Window {
        __balibaloschPendingScrollRestore?: { top: number } | null;
        __balibaloschScrollRestoreBound?: boolean;
      }
    }

    const sharedShellName = "shared";

    const usesSharedShell = (body: HTMLBodyElement | null) =>
      body?.dataset.siteShell === sharedShellName;

    const isSamePageHashNavigation = (from: URL, to: URL) =>
      from.origin === to.origin &&
      from.pathname === to.pathname &&
      from.search === to.search &&
      from.hash !== to.hash;

    const clampScrollTop = (top: number) => {
      const maxScrollTop = Math.max(
        0,
        document.documentElement.scrollHeight - window.innerHeight,
      );

      return Math.min(Math.max(top, 0), maxScrollTop);
    };

    if (!window.__balibaloschScrollRestoreBound) {
      window.__balibaloschScrollRestoreBound = true;
      window.__balibaloschPendingScrollRestore = null;

      document.addEventListener(
        "astro:before-preparation",
        (event: TransitionBeforePreparationEvent) => {
          const shouldRestoreScroll =
            usesSharedShell(document.body) &&
            (event.navigationType === "push" ||
              event.navigationType === "replace") &&
            !isSamePageHashNavigation(event.from, event.to);

          // Save the live page scroll before Astro swaps the body.
          window.__balibaloschPendingScrollRestore = shouldRestoreScroll
            ? { top: window.scrollY }
            : null;
        },
      );

      document.addEventListener("astro:after-swap", () => {
        const pendingScrollRestore = window.__balibaloschPendingScrollRestore;
        window.__balibaloschPendingScrollRestore = null;

        if (!pendingScrollRestore || !usesSharedShell(document.body)) {
          return;
        }

        // Replaying the same scroll position reproduces the same hero/nav overlap.
        window.scrollTo({
          left: 0,
          top: clampScrollTop(pendingScrollRestore.top),
          behavior: "instant",
        });
      });
    }
  </script>
</head>
