---
import SocialDanceButton from "./SocialDanceButton.astro";

const socialDanceButtonsUrl =
  "https://www.maartjedegoede.nl/ontwerp/project/Social%20Dance%20Buttons";
const buttons = Array.from({ length: 10 }, (_, index) => {
  const id = index + 1;

  return {
    src: `/images/social-dance-buttons/x${id}.jpg`,
    cropClass:
      id <= 8
        ? `h-full w-full object-cover scale-235 translate-x-1`
        : `h-full w-full object-cover scale-195`,
    href: socialDanceButtonsUrl,
    alt: `Social dance button ${id}`,
  };
});
---

<div class="d-card bg-base-200 shadow-md">
  <div class="d-card-body p-4">
    <div
      class="not-prose w-full max-w-full overflow-x-auto snap-x snap-mandatory"
    >
      <div class="d-carousel d-carousel-center w-full overscroll-x-contain">
        {
          buttons.map((button) => (
            <div class="d-carousel-item">
              <SocialDanceButton
                src={button.src}
                cropClass={button.cropClass}
                href={button.href}
                alt={button.alt}
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
