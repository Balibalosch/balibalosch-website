---
import "../assets/app.css";
import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Hero from "../components/Hero.astro";
import SiteNavigation from "../components/SiteNavigation.astro";

const pathname = Astro.url.pathname;
---

<html lang="en" class="bg-base-200">
  <Head />
  <body class="min-h-screen bg-base-100 text-base-content">
    <SiteNavigation pathname={pathname}>
      <Hero slot="before-nav" />
      <main class="relative isolate flex-1 bg-amber-50">
        <div class="relative z-20 mx-auto w-full max-w-4xl px-6 py-10">
          <slot />
        </div>
        <div aria-hidden="true" class="paper-texture-overlay"></div>
      </main>
    </SiteNavigation>
    <Footer />
  </body>
</html>
