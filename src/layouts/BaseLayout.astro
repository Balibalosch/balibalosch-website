---
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import TabList from "../components/TabList.astro";

// const { pageTitle } = Astro.props;
---

<div class="drawer min-h-screen">
  <input id="my-drawer-2" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content flex min-h-screen flex-col">
    <Hero />
    <div class="navbar sticky top-0 z-30 w-full bg-base-300">
      <div class="flex-none lg:hidden">
        <label
          for="my-drawer-2"
          aria-label="open sidebar"
          class="btn btn-square btn-ghost"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            class="inline-block h-6 w-6 stroke-current"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </label>
      </div>
      <div class="hidden flex-none lg:block">
        <TabList />
      </div>
    </div>
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </div>
  <div class="drawer-side">
    <label for="my-drawer-2" aria-label="close sidebar" class="drawer-overlay"
    ></label>
    <ul class="menu bg-base-200 min-h-full w-80 p-4">
      <!-- Sidebar content here -->
      <ul class="menu">
        <a href="/" class="tab tab-active text-xl">Bienvenue!</a>
        <a href="/balfolk/" class="tab text-xl">Was? Bal Folk?</a>
        <a href="/code-of-conduct/" class="tab text-xl">Code of Conduct</a>
        <a href="/vielfalt-staerken/" class="tab text-xl"
          >Vielfalt stärken!</a
        >
      </ul>
    </ul>
  </div>
</div>
